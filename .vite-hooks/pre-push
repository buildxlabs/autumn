#!/bin/sh
# Pre-push: clippy and cargo-deny over the Rust workspace, only when pushed
# commits touch Rust sources or manifests (mirrors the gate the nix
# pre-commit setup used).
if ! command -v cargo >/dev/null 2>&1; then
  echo "note: cargo not on PATH; skipping Rust checks" >&2
  exit 0
fi

zero="0000000000000000000000000000000000000000"
ran=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ -n "$local_sha" ] || continue
  if [ -z "$remote_sha" ] || [ "$remote_sha" = "$zero" ]; then
    # New remote branch: the push is the whole commit range.
    ran=1
  elif git diff --name-only "$remote_sha..$local_sha" -- '*.rs' Cargo.toml Cargo.lock | grep -q .; then
    ran=1
  fi
done

if [ "$ran" = 1 ]; then
  cargo clippy --workspace --all-targets --all-features -- -D warnings || exit 1
  if [ -f Cargo.lock ] && command -v cargo-deny >/dev/null 2>&1; then
    cargo deny check || exit 1
  fi
else
  echo "note: no Rust changes in the push; Rust checks skipped" >&2
fi
